<!DOCTYPE html>
<html lang="si">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Live Cricket Score - Sinhala</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI', Arial, sans-serif; }
  html, body { width:100%; height:100%; overflow:hidden; background:#000; }
  #wrap {
    width:100%; height:100%;
    display:flex; flex-direction:column;
    background:linear-gradient(135deg,#7b2ff7,#f107a3);
  }

  #titlestrip {
    background:#000c; color:#fff; font-size:clamp(10px,1.2vw,13px); font-weight:600;
    padding:3px 14px; display:flex; justify-content:space-between; align-items:center;
    flex-shrink:0; white-space:nowrap; overflow:hidden;
  }
  #titlestrip #matchname { color:#ffd400; font-weight:800; overflow:hidden; text-overflow:ellipsis; }
  #titlestrip #clock { flex-shrink:0; margin-left:10px; color:#7cffb2; font-weight:800; }

  #scorebar {
    display:flex; align-items:center; justify-content:space-between;
    padding:8px 20px; background:linear-gradient(90deg,#5b0e9e,#c2116b); flex-shrink:0;
  }
  .teamblock { display:flex; align-items:center; gap:12px; flex:1; min-width:0; }
  .teamblock.right { justify-content:flex-end; }
  .teamlogo {
    width:56px; height:56px; border-radius:50%; background:#fff2; border:3px solid #ffd400;
    display:flex; align-items:center; justify-content:center; overflow:hidden; font-size:10px; color:#fff;
    text-align:center; flex-shrink:0;
  }
  .teaminfo { display:flex; flex-direction:column; min-width:0; }
  .teamname { color:#ffd400; font-weight:800; font-size:13px; letter-spacing:1px; text-shadow:1px 1px 2px #000;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:220px; }
  .teamscore { color:#fff; font-weight:900; font-size:clamp(20px,3vw,32px); display:flex; align-items:baseline; gap:4px;
    text-shadow:2px 2px 3px #0006; }
  .oversmall { font-size:13px; font-weight:700; color:#ffe36b; }

  #midbox { background:#0d1a4d; border:3px solid #ffd400; border-radius:10px; padding:8px 22px; color:#ffe600;
    font-weight:900; font-size:clamp(14px,1.8vw,22px); text-align:center; min-width:130px; box-shadow:0 0 15px #0007; flex-shrink:0; }

  #infostrip { background:#0a2c9c; color:#fff; display:flex; align-items:center; justify-content:space-between;
    padding:6px 20px; font-weight:700; font-size:clamp(11px,1.3vw,15px); flex-shrink:0; gap:10px; white-space:nowrap; overflow:hidden; }
  #infostrip .need { color:#ffd400; overflow:hidden; text-overflow:ellipsis; }
  #infostrip .left { overflow:hidden; text-overflow:ellipsis; }

  #tossstrip { background:#1b1b1b; color:#ffd400cc; font-size:clamp(9px,1.05vw,12px); font-weight:600;
    padding:3px 20px; flex-shrink:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  #tossstrip span.venue { color:#9ecbff; }

  #ground { position:relative; flex:1; background:#111; display:flex; align-items:flex-end; overflow:hidden; min-height:0; }
  #groundimg { position:absolute; inset:0; background:radial-gradient(circle at center,#2e6b2e 0%,#1c4a1c 60%,#0e2a12 100%); }
  .socialbtns { position:absolute; top:10px; left:0; z-index:5; display:flex; flex-direction:column; gap:6px; }
  .socialbtns div { background:#e30613; color:#fff; font-weight:800; font-size:12px; padding:6px 16px 6px 12px;
    border-radius:0 20px 20px 0; box-shadow:2px 2px 5px #0007; }
  #creditbadge { position:absolute; top:10px; right:14px; z-index:5; background:#000a; color:#ffd400; font-weight:800;
    font-size:12px; padding:5px 12px; border-radius:14px; border:1px solid #ffd400; }
  #squadbtn { position:absolute; bottom:6px; right:14px; z-index:6; background:#000a; color:#7cffb2; font-weight:800;
    font-size:11px; padding:5px 10px; border-radius:10px; border:1px solid #7cffb2; cursor:pointer; }

  #playerpanel { position:relative; z-index:4; display:flex; width:100%; flex-shrink:0; }
  .pcard { flex:1; position:relative; display:flex; flex-direction:column; align-items:center; padding:5px 4px 8px; min-width:0; }
  .pcard.batsman { background:linear-gradient(180deg,#0000 0%,#5a0f8f 40%,#5a0f8f 100%); }
  .pcard.bowler { background:linear-gradient(180deg,#0000 0%,#8f0f3a 40%,#8f0f3a 100%); }
  .ptag { background:#000c; color:#ffd400; font-weight:800; font-size:clamp(9px,1.2vw,13px); padding:2px 10px;
    border-radius:6px; margin-bottom:2px; display:flex; align-items:center; gap:6px; }
  .pname { color:#fff; font-weight:800; font-size:clamp(10px,1.4vw,15px); text-shadow:1px 1px 2px #000;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:95%; }
  .pscore { color:#ffe600; font-weight:900; font-size:clamp(18px,2.4vw,27px); text-shadow:2px 2px 2px #000; }
  .psub { color:#e8e8e8; font-size:clamp(9px,1.05vw,12px); font-weight:700; }

  #keystatstrip { background:#2a0a0a; color:#ffb3b3; font-size:clamp(9px,1.05vw,12px); font-weight:600;
    padding:3px 20px; flex-shrink:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  #commentary { background:#050505; color:#fff; padding:7px 14px; font-size:clamp(11px,1.3vw,14px); line-height:1.3;
    flex-shrink:0; border-top:2px solid #ffd400; max-height:54px; overflow:hidden; display:flex; align-items:center; gap:10px; }
  #commentary b { color:#ffd400; flex-shrink:0; }
  #cmtText { overflow:hidden; text-overflow:ellipsis; }
  #speakerIcon { flex-shrink:0; cursor:pointer; font-size:16px; }
  #speakerIcon.muted { opacity:0.4; }

  #ticker { display:flex; align-items:center; gap:6px; background:#111; padding:5px 10px; flex-shrink:0; overflow-x:auto; }
  #ticker::-webkit-scrollbar{ display:none; }
  .ball { min-width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    font-weight:800; font-size:12px; color:#fff; background:#333; flex-shrink:0; }
  .ball.four { background:#1976d2; }
  .ball.six { background:#7b1fa2; }
  .ball.wicket { background:#c62828; }
  .ball.wide, .ball.nb { background:#455a64; font-size:9px; }
  .oversep { color:#ffd400; font-weight:800; font-size:11px; padding:0 6px; }

  #status { position:fixed; bottom:4px; left:10px; color:#fff9; font-size:10px; z-index:50; }

  #squadModal { position:fixed; inset:0; z-index:100; background:#000d; display:none; align-items:center; justify-content:center; }
  #squadModal.open { display:flex; }
  #squadBox { background:#12122a; border:2px solid #ffd400; border-radius:12px; width:min(92%,700px); max-height:85%;
    overflow-y:auto; padding:16px 20px; color:#fff; position:relative; }
  #squadBox h3 { color:#ffd400; margin-bottom:6px; font-size:15px; }
  #squadBox .teamsq { margin-bottom:14px; }
  #squadBox ul { list-style:none; font-size:13px; line-height:1.7; padding-left:4px; }
  #squadBox .officials { font-size:12px; color:#9ecbff; margin-top:10px; }
  #closeSquad { position:absolute; top:8px; right:14px; color:#ff6b6b; font-weight:900; font-size:20px; cursor:pointer; }
</style>
</head>
<body>
<div id="wrap">

  <div id="titlestrip">
    <span id="matchname">-</span>
    <span id="clock">🇱🇰 -- : -- : --</span>
  </div>

  <div id="scorebar">
    <div class="teamblock">
      <div class="teamlogo" id="team1logo">T1</div>
      <div class="teaminfo">
        <div class="teamname" id="team1name">TEAM 1</div>
        <div class="teamscore"><span id="team1score">0-0</span><span class="oversmall" id="team1overs"></span></div>
      </div>
    </div>

    <div id="midbox">ඕවර්</div>

    <div class="teamblock right">
      <div class="teaminfo" style="align-items:flex-end;">
        <div class="teamname" id="team2name">TEAM 2</div>
        <div class="teamscore"><span id="team2score">0-0</span><span class="oversmall" id="team2overs">0.0</span></div>
      </div>
      <div class="teamlogo" id="team2logo">T2</div>
    </div>
  </div>

  <div id="infostrip">
    <span class="left">CRR: <b id="crr">-</b> &nbsp; RRR: <b id="rrr">-</b> &nbsp; හවුල: <b id="partnership">-</b></span>
    <span class="need" id="needtext">-</span>
  </div>

  <div id="tossstrip">
    <span id="tosstext">-</span> &nbsp;•&nbsp; <span class="venue" id="venuetext">-</span>
  </div>

  <div id="ground">
    <div id="groundimg"></div>
    <div class="socialbtns">
      <div>+</div>
      <div>+ LIKE</div>
      <div>+ SHARE</div>
      <div>+ COMMENT</div>
    </div>
    <div id="creditbadge">Created by Viru</div>
    <div id="squadbtn" onclick="openSquads()">👥 Squads / Officials</div>

    <div id="playerpanel">
      <div class="pcard batsman">
        <div class="ptag">🏏 පිතිකරු</div>
        <div class="pname" id="bat1name">-</div>
        <div class="pscore" id="bat1score">-</div>
        <div class="psub" id="bat1sub">-</div>
      </div>
      <div class="pcard batsman">
        <div class="ptag">🏏 පිතිකරු</div>
        <div class="pname" id="bat2name">-</div>
        <div class="pscore" id="bat2score">-</div>
        <div class="psub" id="bat2sub">-</div>
      </div>
      <div class="pcard bowler">
        <div class="ptag">🎾 බෝලර්</div>
        <div class="pname" id="bowlname">-</div>
        <div class="pscore" id="bowlscore">-</div>
        <div class="psub" id="bowlsub">-</div>
      </div>
    </div>
  </div>

  <div id="keystatstrip">🎯 <span id="lastwicket">-</span></div>

  <div id="commentary">
    <b id="cmtOver">-</b>
    <span id="cmtText">විස්තර එනතුරු රැඳී සිටින්න...</span>
    <span id="speakerIcon" title="හඬ නවත්වන්න/පණගන්වන්න">🔊</span>
  </div>

  <div id="ticker"></div>

</div>

<div id="squadModal">
  <div id="squadBox">
    <span id="closeSquad" onclick="closeSquads()">✕</span>
    <div class="teamsq">
      <h3 id="sq1name">Team 1</h3>
      <ul id="sq1list"></ul>
    </div>
    <div class="teamsq">
      <h3 id="sq2name">Team 2</h3>
      <ul id="sq2list"></ul>
    </div>
    <div class="officials" id="officialsBox">-</div>
  </div>
</div>

<div id="status">යාවත්කාලීන වෙමින්...</div>

<script>
const API_URL = "https://cricket-api-v2.vercel.app/";
const POLL_MS = 10000;
let lastCommentaryText = "";
let ttsMuted = false;

function updateClock(){
  const now = new Date();
  const sl = new Date(now.toLocaleString("en-US", { timeZone: "Asia/Colombo" }));
  const hh = String(sl.getHours()).padStart(2,"0");
  const mm = String(sl.getMinutes()).padStart(2,"0");
  const ss = String(sl.getSeconds()).padStart(2,"0");
  document.getElementById("clock").textContent = "🇱🇰 " + hh + ":" + mm + ":" + ss;
}
setInterval(updateClock, 1000);
updateClock();

async function translateToSinhala(text){
  if(!text) return "";
  try{
    const url = "https://api.mymemory.translated.net/get?q=" + encodeURIComponent(text) + "&langpair=en|si";
    const r = await fetch(url);
    const j = await r.json();
    if(j && j.responseData && j.responseData.translatedText){
      return j.responseData.translatedText;
    }
  }catch(e){ /* fall through */ }
  return text;
}

function speakSinhala(text){
  if(ttsMuted || !text) return;
  if(!("speechSynthesis" in window)) return;
  window.speechSynthesis.cancel();
  const utter = new SpeechSynthesisUtterance(text);
  const voices = window.speechSynthesis.getVoices();
  const siVoice = voices.find(v => v.lang && v.lang.toLowerCase().startsWith("si"));
  if(siVoice) utter.voice = siVoice;
  utter.lang = "si-LK";
  utter.rate = 0.95;
  window.speechSynthesis.speak(utter);
}
document.getElementById("speakerIcon").addEventListener("click", () => {
  ttsMuted = !ttsMuted;
  const el = document.getElementById("speakerIcon");
  el.textContent = ttsMuted ? "🔇" : "🔊";
  el.classList.toggle("muted", ttsMuted);
  if(ttsMuted) window.speechSynthesis.cancel();
});

function ballClass(token){
  token = (token||"").toString().trim().toLowerCase();
  if(token === "6" || token === "six") return "six";
  if(token === "4" || token === "four") return "four";
  if(token === "w" || token === "wicket") return "wicket";
  if(token.includes("wd")) return "wide";
  if(token.includes("nb")) return "nb";
  return "";
}
function renderTicker(recentStr){
  const el = document.getElementById("ticker");
  el.innerHTML = "";
  if(!recentStr) return;
  const parts = recentStr.split("|");
  parts.forEach((seg, i) => {
    seg.trim().split(/\s+/).forEach(tok => {
      if(!tok) return;
      const div = document.createElement("div");
      const cls = ballClass(tok);
      div.className = "ball" + (cls ? " " + cls : "");
      div.textContent = tok.toUpperCase();
      el.appendChild(div);
    });
    if(i < parts.length - 1){
      const sep = document.createElement("div");
      sep.className = "oversep";
      sep.textContent = "|";
      el.appendChild(sep);
    }
  });
}

let lastData = null;
function openSquads(){
  if(!lastData || !lastData.squads) return;
  const t1 = lastData.squads.team1, t2 = lastData.squads.team2;
  document.getElementById("sq1name").textContent = (t1 && t1.name) || "Team 1";
  document.getElementById("sq2name").textContent = (t2 && t2.name) || "Team 2";
  document.getElementById("sq1list").innerHTML = ((t1 && t1.players) || []).map(p => "<li>• "+p+"</li>").join("");
  document.getElementById("sq2list").innerHTML = ((t2 && t2.players) || []).map(p => "<li>• "+p+"</li>").join("");
  const off = lastData.officials || {};
  document.getElementById("officialsBox").innerHTML =
    "🧑‍⚖️ Umpire 1: " + (off.umpire1||"-") + "<br>" +
    "🧑‍⚖️ Umpire 2: " + (off.umpire2||"-") + "<br>" +
    "📺 Third Umpire: " + (off.umpire3||"-") + "<br>" +
    "🎙️ Referee: " + (off.referee||"-");
  document.getElementById("squadModal").classList.add("open");
}
function closeSquads(){ document.getElementById("squadModal").classList.remove("open"); }

async function refresh(){
  const statusEl = document.getElementById("status");
  try{
    const res = await fetch(API_URL, { cache: "no-store" });
    const data = await res.json();
    lastData = data;

    document.getElementById("matchname").textContent = data.match || "-";

    let t1name = "-", t1score = "-", t2name = data.team || "-", t2score = data.score || "-";
    if(data.matchScore){
      const m = data.matchScore.split(" vs ");
      if(m.length === 2){
        const p1 = m[0].trim().split(" ");
        const p2 = m[1].trim().split(" ");
        t1name = p1[0]; t1score = p1.slice(1).join(" ");
        t2name = p2[0]; t2score = p2.slice(1).join(" ");
      }
    }
    document.getElementById("team1name").textContent = t1name;
    document.getElementById("team1score").textContent = t1score;
    document.getElementById("team2name").textContent = t2name;
    document.getElementById("team2score").textContent = t2score;
    document.getElementById("team2overs").textContent = data.overs || "";

    document.getElementById("midbox").textContent =
      (data.matchMeta && data.matchMeta.shortStatus) ? data.matchMeta.shortStatus : "ඕවර්";

    document.getElementById("partnership").textContent =
      (data.keyStats && data.keyStats.partnership) || "-";
    document.getElementById("needtext").textContent =
      (data.matchMeta && data.matchMeta.state) || "";

    document.getElementById("tosstext").textContent = data.toss || "-";
    document.getElementById("venuetext").textContent = data.venue || "-";

    document.getElementById("lastwicket").textContent =
      (data.keyStats && data.keyStats.lastWicket) || "-";

    const b = data.batsmen || [];
    if(b[0]){
      document.getElementById("bat1name").textContent = b[0].name || "-";
      const m1 = (b[0].score||"").match(/(\d+)\((\d+)\)/);
      document.getElementById("bat1score").textContent = m1 ? m1[1] : (b[0].score||"-");
      document.getElementById("bat1sub").textContent = m1 ? "("+m1[2]+")" : "";
    }
    if(b[1]){
      document.getElementById("bat2name").textContent = b[1].name || "-";
      const m2 = (b[1].score||"").match(/(\d+)\((\d+)\)/);
      document.getElementById("bat2score").textContent = m2 ? m2[1] : (b[1].score||"-");
      document.getElementById("bat2sub").textContent = m2 ? "("+m2[2]+")" : "";
    }
    document.getElementById("bowlname").textContent = data.bowler || "-";

    renderTicker(data.recent);

    if(data.commentary && data.commentary.text){
      document.getElementById("cmtOver").textContent = "ඕවර් " + (data.commentary.over || "") + ":";
      const translated = await translateToSinhala(data.commentary.text);
      document.getElementById("cmtText").textContent = translated;

      if(translated && translated !== lastCommentaryText){
        lastCommentaryText = translated;
        speakSinhala(translated);
      }
    }

    statusEl.textContent = "අවසන් යාවත්කාලීන: " + new Date().toLocaleTimeString("si-LK");
  }catch(err){
    statusEl.textContent = "දෝෂයක්: API එකට සම්බන්ධ විය නොහැක";
    console.error(err);
  }
}

if("speechSynthesis" in window){ window.speechSynthesis.getVoices(); }

refresh();
setInterval(refresh, POLL_MS);
</script>
</body>
</html>
